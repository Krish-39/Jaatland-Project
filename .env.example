# Copy to .env.local for local development. Never commit real values.

# Postgres connection string (Neon). Leave unset locally to use the embedded
# development database in .data/pglite, which is created automatically.
DATABASE_URL=

# Admin account, created or updated by `npm run db:migrate` (and on first
# start of the embedded database). Use a long, unique password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe secret key for the payment endpoint (test mode key: sk_test_...).
STRIPE_SECRET_KEY=
